# notebooks themselves are the deliverable and stay tracked.

# Generated audit artefacts. These are rebuilt by scripts/run_audit.py; the
# committed copies under results/ are the ones CI checks for drift, so only
# scratch output is ignored here.
results/_scratch/
nbconvert_out/

# OS noise
.DS_Store
Thumbs.db
